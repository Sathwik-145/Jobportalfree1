# Copy to .env for local work. For the live site, add the same names in Cloudflare
# (Workers & Pages -> your project -> Settings -> Variables and Secrets).
# VITE_* values are baked in when the site is BUILT, so add them as *Build* variables too.

# ---- Supabase (Project Settings -> API) ----
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR-PUBLISHABLE-OR-ANON-KEY"
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"

# Your site's public address, used for pictures and links inside emails
VITE_SITE_URL="https://your-site.example.com"

# ---- Runtime variables / secrets (Cloudflare "Variables and Secrets", type Secret) ----
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="YOUR-PUBLISHABLE-OR-ANON-KEY"
# SUPABASE_SERVICE_ROLE_KEY=""      # optional secret; without it the server uses CRON_SECRET
CRON_SECRET=""                      # long random string; also add it as a GitHub Actions secret
BREVO_API_KEY=""                    # email sending
BREVO_SENDER_EMAIL=""
GEMINI_API_KEY=""                   # AI chat and admin assistant
